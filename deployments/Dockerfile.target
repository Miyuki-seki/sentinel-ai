FROM golang:alpine AS builder
WORKDIR /src
COPY go.mod ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bin/mock-target ./cmd/mock-target

FROM alpine:3.21
WORKDIR /app
COPY --from=builder /bin/mock-target /app/mock-target
EXPOSE 8081
ENTRYPOINT ["/app/mock-target"]
