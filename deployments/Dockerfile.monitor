FROM golang:alpine AS builder
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bin/monitor ./cmd/monitor

FROM alpine:3.21
RUN apk add --no-cache ca-certificates
WORKDIR /app
COPY --from=builder /bin/monitor /app/monitor
EXPOSE 8080
ENTRYPOINT ["/app/monitor"]
